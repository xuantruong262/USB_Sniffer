; Pico USB Sniffer - PIO capture programs
;
; Derived from pico-usb-sniffer-lite (https://github.com/therealdreg/pico-usb-sniffer-lite)
; which is a fork of https://github.com/ataradov/usb-sniffer-lite
;
; SPDX-License-Identifier: BSD-3-Clause
; Copyright (c) 2022, Alex Taradov <alex@taradov.com>. All rights reserved.
; Copyright (c) 2025, David Reguera Garcia aka Dreg
;
; Pin mapping (IN base = D+):
;   IN PIN 0 : D+    (GP10)
;   IN PIN 1 : D-    (GP11)
;   IN PIN 2 : START (GP12, internal signal PIO1 -> PIO0, leave unconnected)
;
; Clocking: the PIO runs at 10x the USB bit rate
;   Low Speed  : 1.5 Mbit/s -> 15 MHz  (clk_sys 120 MHz / 8)
;   Full Speed : 12  Mbit/s -> 120 MHz (clk_sys 120 MHz / 1)
;
; Output format of tar_pio0 (RX FIFO, joined, 8 words):
;   - data words : up to 31 raw D+ samples, bit 31 always 0 (autopush @ 31 bits, shift left)
;   - size word  : 0xFFFFFFFF - number_of_sampled_bits, bit 31 always 1 (end of packet)
;   - 0xFFFFFFFF : SE0 longer than ~32 polls (bus reset), i.e. size 0
; The CPU performs NRZI decoding, bit unstuffing and CRC checks.

; ---- templates (patched into tar_pio0 slots 01/02 at runtime) --------------------

.program usb_low_speed_template
    wait 1 PIN 1             ; 01 Wait until the bus goes idle (LS idle J: D- high)
    wait 0 PIN 1             ; 02 Wait for the SOP

.program usb_full_speed_template
    wait 1 PIN 0             ; 01 Wait until the bus goes idle (FS idle J: D+ high)
    wait 0 PIN 0             ; 02 Wait for the SOP

; ---- PIO0: bit sampler ------------------------------------------------------------
; MUST be exactly 32 instructions and loaded at offset 0: the entry point is
; instruction 31, after which the PC rolls over to 0.
;
; FIFO_JOIN_RX, JMP PIN = D+ (LS) / D- (FS)
; shift ISR left, autopush, threshold 31 ; shift OSR left, no autopull
.program tar_pio0
.origin 0
.wrap_target
idle:
    mov X, !NULL             ; 00 bit counter = 0xffffffff
    nop                      ; 01 replaced by template
    nop                      ; 02 replaced by template
start0:
    nop [1]                  ; 03 skip to the middle of the bit
read0:
    jmp X-- pio0_label_4     ; 04 decrement the bit counter
pio0_label_4:
    in PINS, 1               ; 05 sample D+
    mov OSR, ::PINS          ; 06 sample D+ and D- (bit reversed)
    out Y, 2                 ; 07
    jmp !Y eop               ; 08 SE0 -> end of packet
    nop [3]                  ; 09 skip to the middle of the bit
    jmp PIN read0            ; 10
read1:
    jmp X-- pio0_label_6     ; 11
pio0_label_6:
    in PINS, 1               ; 12 sample D+
    mov OSR, ::PINS          ; 13
    out Y, 2                 ; 14
    jmp !Y eop               ; 15
    jmp PIN start0           ; 16 look for a transition to re-align
    jmp PIN start0           ; 17 the sample point
    jmp PIN start0           ; 18
    jmp PIN start0           ; 19
    jmp read1                ; 20
eop:
    push noblock             ; 21 last (partial) data word
    mov ISR, X               ; 22 bit count
    push noblock             ; 23
poll_reset:
    set X, 31                ; 24
poll_loop:
    mov OSR, ::PINS          ; 25
    out Y, 2                 ; 26
    jmp Y-- idle             ; 27 line left SE0 -> idle
    jmp X-- poll_loop        ; 28
    mov ISR, !NULL           ; 29 long SE0: bus reset marker 0xffffffff
    push noblock             ; 30
.wrap
    wait 1 PIN 2             ; 31 entry point: wait for START from PIO1

; ---- PIO1: start synchroniser -----------------------------------------------------
; Waits for a valid SE0 (end of some packet) and then raises START once, so that
; PIO0 begins sampling aligned to packet boundaries. After that it idles forever.
.program tar_pio1
    set pindirs, 1
    set pins, 0
.wrap_target
    nop [31]
    nop [31]
    nop [31]
    nop [31]
wait_se0:
    mov OSR, ::PINS
    out Y, 2
    jmp Y-- wait_se0
    mov OSR, ::PINS
    out Y, 2
    jmp Y-- wait_se0
    mov OSR, ::PINS
    out Y, 2
    jmp Y-- wait_se0
    mov OSR, ::PINS
    out Y, 2
    jmp Y-- wait_se0
    set PINS, 1
infinite_loop:
    jmp infinite_loop
.wrap
